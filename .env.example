# Base URL for the transfer service
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob Storage Token (required for production on Vercel)
# Get this from Vercel Project Dashboard -> Storage -> Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# Secret used to sign device tokens & pairing cookies (HMAC SHA-256)
TRANSFER_AUTH_SECRET=generate_a_random_32_character_secret_here

# Default transfer expiration in hours (default: 24)
TRANSFER_EXPIRATION_HOURS=24

# Optional: maximum upload size limit in bytes (e.g. 500MB = 524288000)
MAX_UPLOAD_SIZE_BYTES=524288000
